# Salin ke .env.local untuk pengembangan lokal. Di Vercel, isi lewat Settings > Environment Variables.
# JANGAN commit file .env / .env.local ke GitHub.

# --- Database Neon (otomatis terisi bila memakai integrasi Neon di Vercel Storage) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- Login dashboard (wajib) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
# String acak panjang (minimal 32 karakter) untuk menandatangani sesi login
DASHBOARD_SESSION_SECRET=ganti-dengan-string-acak-panjang
# Role akun login: PRQ_INTERNAL (default, punya akses master) atau VIEWER (hanya lihat)
DASHBOARD_USER_ROLE=PRQ_INTERNAL

# --- Password untuk membuka menu Master (upload data). WAJIB diganti: bawaan kode adalah 123456 ---
MASTER_ACCESS_PASSWORD=ganti-dengan-password-master

# --- Opsional: bot Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
